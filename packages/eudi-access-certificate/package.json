{
  "name": "@owf/eudi-access-certificate",
  "version": "0.0.0",
  "description": "Parse, validate and create EUDI Wallet-Relying Party access certificates per ETSI TS 119 411-8",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "exports": "./src/index.ts",
  "homepage": "https://github.com/openwallet-foundation-labs/identity-common-ts/tree/main/packages/eudi-access-certificate",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation-labs/identity-common-ts",
    "directory": "packages/eudi-access-certificate"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --sourcemap"
  },
  "dependencies": {
    "@owf/identity-common": "workspace:*",
    "@owf/x509": "workspace:*"
  },
  "keywords": [
    "eudi",
    "wallet",
    "access-certificate",
    "relying-party",
    "etsi",
    "ts-119-411-8",
    "x509",
    "eidas"
  ]
}
