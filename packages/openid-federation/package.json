{
  "name": "@owf/openid-federation",
  "version": "0.6.0",
  "description": "OpenID Federation 1.0: create, fetch and validate entity statements, and resolve trust chains with metadata policies",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "exports": "./src/index.ts",
  "homepage": "https://github.com/openwallet-foundation-labs/identity-common-ts/tree/main/packages/openid-federation",
  "repository": {
