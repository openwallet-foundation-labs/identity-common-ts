{
  "name": "@owf/x509",
  "version": "0.6.0",
  "description": "Environment agnostic X.509 certificate and CRL parsing, creation and verification with pluggable crypto",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "exports": "./src/index.ts",
  "homepage": "https://github.com/openwallet-foundation-labs/identity-common-ts/tree/main/packages/x509",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation-labs/identity-common-ts",
    "directory": "packages/x509"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap"
  },
  "dependencies": {
    "@owf/identity-common": "workspace:*",
    "@peculiar/asn1-schema": "catalog:",
    "@peculiar/asn1-x509": "catalog:",
    "@peculiar/asn1-x509-qualified": "catalog:",
    "@peculiar/asn1-x509-qualified-etsi": "catalog:",
    "asn1js": "^3.1.0"
  },
  "keywords": [
    "x509",
    "certificate",
    "crl",
    "pkix",
    "rfc5280",
    "asn1",
    "react-native"
  ]
}
