{
  "name": "@owf/eudi-sca",
  "version": "0.5.2",
  "description": "Tools and utilities for EUDI Strong Customer Authentication per TS12",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "exports": "./src/index.ts",
  "homepage": "https://github.com/openwallet-foundation-labs/identity-common-ts/tree/main/packages/eudi-sca",
  "repository": {
    "type": "git",
