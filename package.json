{
  "name": "identity-common-ts",
  "private": true,
  "description": "Environment agnostic TypeScript libraries and tools for working with digital identity",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "repository": {
    "url": "https://github.com/openwallet-foundation-labs/identity-common-ts",
    "type": "git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "pretypes:check": "turbo run build",
    "types:check": "tsc --noEmit",
    "style:check": "biome check --unsafe",
    "style:fix": "biome check --write --unsafe",
    "md:check": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\"",
    "packages:check": "node scripts/check-package-entrypoints.mjs",
    "esm:check": "node scripts/check-package-esm-imports.mjs",
    "ci:check": "pnpm style:check && pnpm md:check && pnpm types:check && pnpm test",
    "build": "turbo run build",
    "test": "turbo run test",
    "create-package": "node scripts/create-package.mjs",
    "release": "pnpm packages:check && pnpm types:check && pnpm build && pnpm esm:check && pnpm changeset publish --no-git-tag 2>&1 | tee changeset-publish.log",
    "changeset-version": "pnpm changeset version && pnpm style:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@changesets/cli": "^2.31.0",
    "@owf/crypto": "workspace:*",
    "@owf/identity-common": "workspace:*",
    "@owf/token-status-list": "workspace:*",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "tsdown": "0.22.3",
    "tsx": "^4.23.0",
    "turbo": "^2.10.3",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,json}": "biome check --write --unsafe",
    "*.md": "markdownlint-cli2 --fix"
  }
}
