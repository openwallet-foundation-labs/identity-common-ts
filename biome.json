{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "maxSize": 10000000
  },
  "formatter": {
    "lineWidth": 120,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "lineWidth": 120,
      "indentStyle": "space"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error"
      },
      "correctness": {
        "preset": "recommended",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/oauth2/src/**",
        "packages/openid4vci/src/**",
        "packages/openid4vp/src/**",
        "packages/openid4vc-utils/src/**",
        "!**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "URL": "URL should be imported from the @openid4vc/utils package.",
                  "URLSearchParams": "URLSearchParams should be imported from the @openid4vc/utils package.",
                  "fetch": "fetch should be imported from the @openid4vc/utils package.",
                  "Response": "Response should be imported from the @openid4vc/utils package.",
                  "Headers": "Headers should be imported from the @openid4vc/utils package."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "useIgnoreFile": true,
    "clientKind": "git",
    "enabled": true
  }
}
